# /etc/pypi-server/env — 由 systemd 读取，改完 `sudo systemctl restart pypi-server`
# 所有项都可留空，留空即默认值。详细说明见 README。

# ---- 域名与 HTTPS -----------------------------------------------------------
# 填了域名就自动申请 Let's Encrypt 证书：:443 提供服务，:80 做 ACME 验证 + 跳转 https。
# 前提：DNS A 记录指向本机公网 IP，安全组放行 80/443。多个域名用逗号分隔。
#PYPI_TLS_DOMAINS=pypi.example.com
#PYPI_TLS_EMAIL=you@example.com

# 没有域名 / 在反向代理后面时：监听地址 + 对外地址
#PYPI_ADDR=:8080
#PYPI_BASE_URL=https://pypi.example.com

# ---- 管理后台 -----------------------------------------------------------------
# 首页永远是客户自查页；后台挂在这个前缀下。想藏起来就改成一个别人猜不到的路径。
#PYPI_ADMIN_PATH=/admin

# ---- 文件存储 -----------------------------------------------------------------
# 留空 = 本机 /var/lib/pypi-server/blobs。
# 阿里云 OSS（官方 SDK，region 是 Bucket 所在地域，如 cn-hangzhou / cn-guangzhou）：
#PYPI_BLOB_URL=oss://my-bucket?region=cn-hangzhou
#OSS_ACCESS_KEY_ID=LTAI5t...
#OSS_ACCESS_KEY_SECRET=...
# 腾讯 COS / MinIO / R2 等 S3 兼容服务：
#PYPI_BLOB_URL=s3://my-bucket?endpoint=https://cos.ap-guangzhou.myqcloud.com&region=ap-guangzhou&request_checksum_calculation=when_required&response_checksum_validation=when_required
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...
# 下载 302 到 10 分钟有效的签名 URL（带宽不经过本机）；false = 由本机转发
#PYPI_BLOB_SIGNED_URLS=true

# ---- 其它 ---------------------------------------------------------------------
#PYPI_SESSION_TTL=168h
#PYPI_MAX_UPLOAD_MB=512
#TZ=Asia/Shanghai
